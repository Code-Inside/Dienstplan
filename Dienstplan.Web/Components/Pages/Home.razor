@page "/"

<PageTitle>Dienstplan</PageTitle>

@* The page is static; all interaction lives in wwwroot/app.js so it keeps working when iOS suspends the tab. *@
<div class="app">
    <header class="topbar">
        <div class="brand">
            <img class="logo" src="@Assets["logo.svg"]" alt="" width="46" height="46" />
            <div>
                <h1>Dienstplan</h1>
                <p>Antippen – ab in den Kalender.</p>
            </div>
        </div>
        <div class="actions">
            <button id="theme-toggle" class="icon-btn" type="button" aria-label="Hell/Dunkel umschalten" title="Hell/Dunkel umschalten">
                <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" /></svg>
                <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.2" /><path d="M12 2v2.2M12 19.8V22M2 12h2.2M19.8 12H22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6" /></svg>
            </button>
            <button id="open-settings" class="icon-btn" type="button" aria-label="Meine Dienste bearbeiten" title="Meine Dienste bearbeiten">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h10M18 7h2M4 17h4M12 17h8" /><circle cx="16" cy="7" r="2" /><circle cx="10" cy="17" r="2" /></svg>
            </button>
        </div>
    </header>

    <section class="card" aria-labelledby="month-label">
        <div class="month-nav">
            <button id="prev-month" class="icon-btn" type="button" aria-label="Vorheriger Monat">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7" /></svg>
            </button>
            <h2 id="month-label" aria-live="polite"></h2>
            <button id="next-month" class="icon-btn" type="button" aria-label="Nächster Monat">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7" /></svg>
            </button>
        </div>

        <div class="weekdays" aria-hidden="true">
            <span>Mo</span><span>Di</span><span>Mi</span><span>Do</span><span>Fr</span><span class="weekend">Sa</span><span class="weekend">So</span>
        </div>
        <div id="grid" class="grid"></div>

        <div class="month-footer">
            <div id="summary" class="summary"></div>
            <button id="clear-month" class="link-btn" type="button">Monat leeren</button>
        </div>
    </section>

    <ol class="howto">
        <li>Dienst unten auswählen</li>
        <li>Tage im Kalender antippen</li>
        <li>„In den Kalender“ tippen</li>
    </ol>
</div>

<div class="dock">
    <div class="dock-inner">
        <div id="palette" class="palette" role="radiogroup" aria-label="Dienst zum Eintragen"></div>
        <a id="export" class="primary" href="#" aria-disabled="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="3" /><path d="M8 2.5v4M16 2.5v4M12 11v6M9 14h6" /></svg>
            <span id="export-label">In den Kalender</span>
        </a>
    </div>
</div>

<dialog id="settings" aria-labelledby="settings-title">
    <form method="dialog" class="sheet">
        <header class="sheet-head">
            <h2 id="settings-title">Meine Dienste</h2>
            <button class="icon-btn" value="close" aria-label="Schließen">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
        </header>
        <p class="muted">Alle Dienste werden als ganztägige Termine eingetragen. Deine Einstellungen werden nur in diesem Browser gespeichert.</p>
        <div id="shift-list" class="shift-list"></div>
        <div class="sheet-actions">
            <button id="add-shift" class="secondary" type="button">+ Dienst hinzufügen</button>
            <button id="reset-shifts" class="link-btn" type="button">Standard wiederherstellen</button>
        </div>
    </form>
</dialog>

<div id="toast" class="toast" role="status" aria-live="polite"></div>
