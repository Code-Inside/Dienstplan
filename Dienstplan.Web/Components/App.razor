<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f6f3ee" />
    <meta name="color-scheme" content="light dark" />
    @* Name + icon when added to the iPhone home screen. Deliberately no standalone mode:
       inside Safari the .ics link opens the native "Add to calendar" sheet reliably. *@
    <meta name="apple-mobile-web-app-title" content="Dienstplan" />
    <base href="/" />
    <script>
        // Apply the theme before first paint to avoid a light/dark flash.
        (function () {
            var theme;
            try { theme = localStorage.getItem('dienstplan.theme'); } catch (e) { }
            if (theme !== 'light' && theme !== 'dark')
                theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            document.documentElement.dataset.theme = theme;
        })();
    </script>
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="icon" type="image/svg+xml" href="@Assets["logo.svg"]" />
    <link rel="icon" type="image/png" href="@Assets["favicon.png"]" />
    <link rel="apple-touch-icon" href="@Assets["apple-touch-icon.png"]" />

    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="@Assets["app.js"]" defer></script>
</body>

</html>
